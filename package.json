{
  "name": "verifactu-ts",
  "version": "0.3.0",
  "description": "VeriFactu (AEAT) para TypeScript y Node: huella, encadenamiento, código QR, XML del registro de facturación y validación previa con los códigos de error oficiales. Sin dependencias.",
  "keywords": [
    "verifactu",
    "veri-factu",
    "aeat",
    "facturacion",
    "hash",
    "huella",
    "qr",
    "xml",
    "validacion",
    "españa",
    "rd-1007-2023",
    "antifraude",
    "invoicing"
  ],
  "license": "MIT",
  "author": "Juan Archidona",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuanArchidona/verifactu-ts.git"
  },
  "bugs": {
    "url": "https://github.com/JuanArchidona/verifactu-ts/issues"
  },
  "homepage": "https://github.com/JuanArchidona/verifactu-ts#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json && node --test dist-test/test/*.test.js",
    "muestras": "node tools/generar-muestras.mjs",
    "validar:xsd": "npm test && node tools/generar-muestras.mjs && python tools/validar-xsd.py",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsqr": "^1.4.0",
    "typescript": "^5.7.0"
  }
}
